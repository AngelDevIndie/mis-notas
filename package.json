{
  "name": "mis-notas",
  "productName": "Mis Notas",
  "version": "0.2.0",
  "description": "Editor de notas de escritorio con pestañas que no pierde nada de lo que escribes.",
  "author": "AngelDevIndie",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT",
  "build": {
    "appId": "io.github.angeldevindie.misnotas",
    "productName": "Mis Notas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "js/**",
      "icono.png",
      "LICENSE"
    ],
    "win": {
      "icon": "icono.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mis Notas",
      "artifactName": "Mis-Notas-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Mis-Notas-Portable-${version}.${ext}"
    }
  }
}
